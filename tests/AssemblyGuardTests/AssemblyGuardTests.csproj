<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AssemblyGuardTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repo already vendors Cecil under audit/ for the game-assembly checks in
         tools/Verify-GameAssemblies.ps1; reuse it so this suite needs no package feed. -->
    <Reference Include="Mono.Cecil">
      <HintPath>..\..\audit\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
